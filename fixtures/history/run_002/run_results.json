 last_order_date,\n        sum(amount_paid) as lifetime_value\n    from \"demo_shop\".\"main_marts\".\"fct_orders\"\n    where order_status <> 'returned'\n    group by customer_id\n)\nselect\n    c.customer_id,\n    c.customer_name,\n    c.email,\n    c.country,\n    c.signup_date,\n    coalesce(s.order_count, 0)    as order_count,\n    s.first_order_date,\n    s.last_order_date,\n    coalesce(s.lifetime_value, 0) as lifetime_value\nfrom \"demo_shop\".\"main_staging\".\"stg_customers\" c\nleft join order_stats s using (customer_id)", "relation_name": "\"demo_shop\".\"main_marts\".\"dim_customers\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-26T20:20:04.587579Z", "completed_at": "2026-10-26T20:20:04.588458Z"}, {"name": "execute", "started_at": "2026-10-26T20:20:04.590191Z", "completed_at": "2026-10-26T20:20:04.607514Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.0217132568359375, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.demo_shop.fct_daily_revenue", "compiled": true, "compiled_code": "select\n    order_date                                                           as revenue_date,\n    count(distinct order_id)                                             as orders,\n    count(distinct customer_id)                                          as customers,\n    sum(amount_paid)                                                     as gross_revenue,\n    sum(case when order_status = 'returned' then amount_paid else 0 end) as returned_revenue,\n    sum(amount_paid)\n      - sum(case when order_status = 'returned' then amount_paid else 0 end) as net_revenue\nfrom \"demo_shop\".\"main_marts\".\"fct_orders\"\ngroup by order_date", "relation_name": "\"demo_shop\".\"main_marts\".\"fct_daily_revenue\"", "batch_results": null, "overload_results": null}, {"status": "no-op", "timing": [{"name": "compile", "started_at": "2026-10-26T20:20: